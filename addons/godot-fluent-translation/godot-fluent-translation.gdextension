[configuration]
entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.3
reloadable = true

[libraries]
linux.debug.x86_64 =     "res://addons/godot-fluent-translation/debug/libgodot_fluent_translation.so"
linux.release.x86_64 =   "res://addons/godot-fluent-translation/release/libgodot_fluent_translation.so"
windows.debug.x86_64 =   "res://addons/godot-fluent-translation/debug/godot_fluent_translation.dll"
windows.release.x86_64 = "res://addons/godot-fluent-translation/release/godot_fluent_translation.dll"
macos.debug =            "res://addons/godot-fluent-translation/debug/libgodot_fluent_translation.dylib"
macos.release =          "res://addons/godot-fluent-translation/release/libgodot_fluent_translation.dylib"
macos.debug.arm64 =      "res://addons/godot-fluent-translation/debug/libgodot_fluent_translation.dylib"
macos.release.arm64 =    "res://addons/godot-fluent-translation/release/libgodot_fluent_translation.dylib"
